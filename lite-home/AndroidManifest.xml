<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="local.coocaa.litehome" android:versionCode="5" android:versionName="0.5-test">
    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="22" />
    <application android:label="极简桌面（测试）" android:allowBackup="false"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".LiteHomeActivity" android:exported="true"
            android:screenOrientation="landscape" android:launchMode="singleTask"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
